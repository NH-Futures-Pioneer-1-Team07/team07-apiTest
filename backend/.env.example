# 대상 환경: mock(모의, 기본) 또는 real(실전). 실전에서는 주문·정정·취소 케이스를 건너뛴다.
NH_ENV=mock

# NH선물 API 키. 국내 API용과 해외 API용이 따로 있다. 해외 API는 국내 키로 부르면 EGW016 으로 거절된다.
NH_APP_KEY=
NH_APP_SECRET=
NH_OVERSEAS_APP_KEY=
NH_OVERSEAS_APP_SECRET=

# 아래는 생략하면 기본값을 쓴다
# NH 명세 폴더. 엑셀(*.xlsx)이 있으면 엑셀을, 없으면 apis/*.md 를 읽는다
# NH_DOCS_DIR=../docs/nh-api
# CASES_DIR=../testcases/nh-futures
# ISSUES_DIR=../issues/nh-futures
# DB_PATH=data/runs.sqlite3
# 실전 환경에서 주문 케이스를 허용하려면 true (권장하지 않음)
# ALLOW_REAL_ORDERS=false
